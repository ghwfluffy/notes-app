APP_ENV=development
APP_BASE_PATH=/notes
PUBLIC_URL=http://localhost:8096
AUTH_BASE_URL=http://localhost:8090/auth
OAUTH_SERVER_BASE_URL=http://host.docker.internal:8090/auth
OAUTH_CLIENT_ID=notes
SESSION_COOKIE_NAME=notes_session
SESSION_KEY=replace-with-a-long-random-value
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes_dev_password
POSTGRES_DB=notes
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AGENT_INTEGRATION_TOKEN_SECRET=replace-with-the-shared-agent-integration-secret
FEDERATED_APPS=[]
